{
    "name": "flash-panel",
    "main": "dist/worker.js",
    "account_id": "YOUR_ACCOUNT_ID",
    "compatibility_date": "2025-06-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": { "enabled": true },
    "kv_namespaces": [
        { "binding": "kv", "id": "YOUR_KV_NAMESPACE_ID" }
    ],
    // موتور اتوماسیون — پیشنهاد: ساعتی ('0 * * * *').
    // هر ساعت: نمونه‌گیری مصرف + sweep انقضای کاربران اشتراک + هشدار مصرف ≥۸۰٪
    // + خلاصه‌ی روزانه (digest) در تلگرام — گارد KV جلوی notify تکراری را می‌گیرد.
    "triggers": {
        "crons": ["0 * * * *"]
    }
}
