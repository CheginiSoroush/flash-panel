{
    "name": "flash-panel",
    "main": "dist/panel-full.js",
    "account_id": "YOUR_ACCOUNT_ID",
    "compatibility_date": "2025-06-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": { "enabled": true },
    "kv_namespaces": [
        { "binding": "kv", "id": "YOUR_KV_NAMESPACE_ID" }
    ],
    // اختیاری — نمونه‌گیری خودکار مصرف روزانه برای نمودار Usage History.
    // بدون بازدید پنل هم نمونه‌ی روزانه ثبت می‌شود (۰۳:۰۰ UTC).
    "triggers": {
        "crons": ["0 3 * * *"]
    }
}
